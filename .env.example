# Backup Pro — Environment Variables
# Copy this file to .env and adjust values as needed.

# ============================================================================
# SAFETY
# ============================================================================

# Restrict backup operations to these directories (colon-separated).
# Paths starting with ~/ are expanded to $HOME.
# If empty, defaults to the current working directory (with a warning).
# Example: /home/you/projects:/home/you/code
BACKUP_ALLOWED_ROOTS=

# Where backups and metadata are stored.
# Default: ~/.mcp-backups
# BACKUP_DIR=~/.mcp-backups

# ============================================================================
# LIMITS
# ============================================================================

# How often metadata auto-saves when dirty (ms).
# Default: 30000
# AUTO_SAVE_INTERVAL_MS=30000

# Max characters returned by preview_backup (keeps context from exploding).
# Default: 10000
# MAX_PREVIEW_CHARS=10000

# Max parallel file copies in batch operations (min: 1).
# Default: 5
# BATCH_CONCURRENCY=5

# Max backups per file before cleanup warns (0 = unlimited).
# Default: 0
# MAX_BACKUPS_PER_FILE=0

# Max file size for backup operations (bytes).
# Default: 104857600 (100 MB)
# MAX_FILE_SIZE=104857600

# Max file size for diff operations (bytes).
# Default: 10485760 (10 MB)
# MAX_DIFF_SIZE=10485760

# Max file size for hash computation in get/verify (bytes).
# Default: 104857600 (100 MB)
# MAX_HASH_SIZE=104857600

# ============================================================================
# RATE LIMITING
# ============================================================================

# Max tool calls per window.
# Default: 60
# BACKUP_RATE_LIMIT_MAX=60

# Rate limit window duration (ms).
# Default: 60000
# BACKUP_RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# SEARCH (ripgrep — optional, for search_backup_content)
# ============================================================================

# Max concurrent ripgrep processes (min: 1).
# Default: 8
# MCP_MAX_CONCURRENT_RG=8

# Ripgrep process timeout (ms, min: 1000).
# Default: 30000
# MCP_RG_TIMEOUT_MS=30000

# ============================================================================
# DEBUGGING
# ============================================================================

# Log verbosity: debug, info, warn, error.
# Default: info
# LOG_LEVEL=info
