{
  "name": "backup-pro",
  "version": "1.0.0",
  "description": "Production-grade MCP backup server — file versioning, tags, search, diff, verification, deduplication, and enterprise security hardening — purpose-built for LMs and AI agents.",
  "license": "MIT",
  "author": "Alberto Castro Otero",
  "homepage": "https://github.com/lordc-dev/backup-pro",
  "bugs": "https://github.com/lordc-dev/backup-pro/issues",
  "type": "module",
  "bin": {
    "backup-pro": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "backup",
    "file-versioning",
    "diff",
    "verification",
    "deduplication",
    "backup-pro"
  ],
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^17.6.0",
    "lint-staged": "^17.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
